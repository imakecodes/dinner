DATABASE_URL=mysql://user:pass@mysql:3306/dinner

# Local Docker MariaDB service (docker-compose)
MYSQL_DATABASE=dinner
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

PRISMA_CLIENT_ENGINE_TYPE="library"
APP_PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3-pro-preview
# Use a generateContent-compatible fallback model (recommended: gemini-2.5-flash).
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Email Configuration (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_EMAIL_FROM=onboarding@resend.dev
SMTP_EMAIL_FROM_NAME="POE2 Genie"

# Auth
JWT_SECRET=

# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local AI runtime context file (override).
# Leave unset to use `.ai/ai-context.template.md` automatically.
# AI_CONTEXT_FILE_PATH=.ai/ai-context.local.md
# Create `.ai/ai-context.local.md` only when you need custom local overrides.

# PoE mechanic fact-validation policy
POE_FACT_VALIDATION_MODE=strict
POE_KNOWLEDGE_CACHE_TTL_MIN=360
POE_KNOWLEDGE_FETCH_TIMEOUT_MS=2500

# Optional: disable cron noise in local dev
ENABLE_REPLENISHMENT_CRON=true
